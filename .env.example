# Application settings
APP_NAME=BuyBright
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# PostgreSQL settings
POSTGRES_USER=buybright
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=buybright_db
DATABASE_URL=postgresql+psycopg2://buybright:your_secure_password_here@db:5432/buybright_db

# Redis settings
REDIS_URL=redis://redis:6379/0

# Security secret key (generate with: openssl rand -hex 32)
SECRET_KEY=paste_the_64_character_string_here
